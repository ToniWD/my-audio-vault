# Copy this file to .env and adjust the values before running `docker compose up`.
# Values here are consumed by docker-compose.yml and are never baked into the image.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Port exposed on the host machine.
API_PORT=5204
ASPNETCORE_ENVIRONMENT=Production

# Public URL of the API (used by JWT validation). Change the host/port when the
# API is reached from another machine, e.g. http://192.168.1.10:5204.
AUTH_ISSUER=http://localhost:5204
AUTH_AUDIENCE=http://localhost:8081/

# Generate unique secrets, for example:
#   openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-bytes

# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=music_stream_db
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET_NAME=audio-vault
S3_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
VOLUME_PATH=./data
